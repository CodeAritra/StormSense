# ==========================================
# StormSense Backend Configuration (FastAPI)
# Copy this file to .env:
# cp .env.example .env
# ==========================================

# Backend mode: 'mock' (physics-based advection) or 'onnx' (trained deep learning model)
MODEL_BACKEND=onnx

# Path to the ONNX model file delivered by teammate
MODEL_PATH=../../models/nowcast.onnx

# Data paths (relative to apps/api)
EVENTS_DIR=./data/events
DISTRICTS_FILE=./data/districts.geojson
METRICS_FILE=./data/metrics.json
DB_PATH=./stormsense.db

# Demo Geographic Region (South Bengal Corridor)
REGION_WEST=86.6
REGION_SOUTH=20.85
REGION_EAST=90.1
REGION_NORTH=24.29

# Replay & Alert thresholds
REPLAY_TICK_SECONDS=2.0
ALERT_MIN_PROB=0.5
API_PORT=8000
